# Bảo vệ thư mục license-server (chứa Private Key, Database JSON, .env) khỏi truy cập trực tiếp qua Apache
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^license-server/ - [F,L]
</IfModule>

<FilesMatch "^\.env|docker-compose\.yml|\.sql$|\.json$|\.ts$|\.bat$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

