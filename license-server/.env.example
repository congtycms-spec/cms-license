# ==========================================================
# CENTRAL LICENSE SERVER CONFIGURATION
# ==========================================================
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL for Production VPS / Auto-fallback to persistent JSON DB in dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wp_license_system?schema=public"
USE_POSTGRES=false

# JWT Secret for Admin Dashboard Authentication (RBAC)
ADMIN_JWT_SECRET="replace-with-strong-64-byte-secret-in-production"
ADMIN_JWT_EXPIRES_IN="12h"

# Ed25519 Asymmetric Signing Keys (Base64 encoded raw 32-byte seed / 64-byte secret & 32-byte public key)
# Run `npm run keygen` to generate a fresh pair for your company.
# IMPORTANT: NEVER put ED25519_PRIVATE_KEY_BASE64 inside the WordPress plugin!
ED25519_PRIVATE_KEY_BASE64=""
ED25519_PUBLIC_KEY_BASE64=""

# Trusted Reverse Proxies (comma-separated IPs or CIDRs, e.g. Cloudflare / Local Nginx)
TRUSTED_PROXIES="127.0.0.1,::1"

# Default License Policies
DEFAULT_LEASE_HOURS=24
DEFAULT_GRACE_PERIOD_HOURS=72

